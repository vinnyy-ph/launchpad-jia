{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true
    }
  },
  "crons": [
    {
      "path": "/api/save-metrics",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/plan-lifecycle",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/credit-renewal",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/send-scheduled-emails",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/send-email-reminder",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/process-pre-screening",
      "schedule": "0 3 * * *"
    }
  ]
}
